# ============================================================
# Peridot bot stack configuration (mainnet)
# Copy to .env and fill in the two secret keys before running:
#   cp .env.example .env
# ============================================================

# --- Network (shared by all bots) ---
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
RPC_URL="https://mainnet.sorobanrpc.com"

# --- Core contracts (mainnet, from peridot-contracts/addresses.md) ---
PERIDOTTROLLER_ID="CCVUFGXKFVPAHWMMDDL6HXKUN2B2G73Z27VRM3WXZBBSQEUTNLI6YPEX"

# --- Telegram notifications (optional, shared by both bots) ---
# Create a bot via @BotFather, add it to your team group, then put the group's
# chat ID here (see README "Telegram notifications"). Leave blank to disable.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Keeper report frequency (balances + loop stats) and low-balance threshold.
REPORT_INTERVAL_MS=86400000         # 24 hours
KEEPER_MIN_XLM=5                    # alert when keeper XLM drops below this

# ============================================================
# Liquidation bot
# ============================================================

# Secret key of the liquidator account. Must hold underlying tokens
# (XLM/USDC/EURC) to repay debt during liquidations.
LIQUIDATOR_SECRET=""

# Markets the liquidation bot watches (vaultId = ReceiptVault contract).
MARKETS_JSON='[{"symbol":"XLM","vaultId":"CBU4Y7CJFOUZZE3QBOXTKM54UTUYW3SDJWTNMDGJBNCR5HS5UCEKV3BE","decimals":7},{"symbol":"USDC","vaultId":"CBVUJJIJTRJNOORPPCVH72DP7YDCOMDHI6WYKP3WOFVEPSCVP3TBXHIN","decimals":7},{"symbol":"EURC","vaultId":"CD3WN3PLW63HFZXE56OTRLMBV46WG54TFPGRL4RDQ43HQTTWVB4RPO3G","decimals":7}]'

# Tuning (defaults shown)
POLL_INTERVAL_MS=5000
BORROWER_REFRESH_MS=15000
MIN_SHORTFALL=0
EVENT_BACKLOG=50
EVENT_PAGE_SIZE=50

# Optional: idle-cash rebalance bot. Requires LIQUIDATOR_SECRET to be the
# vault admin, so leave disabled unless the bot key is the admin key.
# Maps vaultId -> underlying token contract ID.
# UNDERLYING_TOKENS_JSON='{"CBU4Y7CJFOUZZE3QBOXTKM54UTUYW3SDJWTNMDGJBNCR5HS5UCEKV3BE":"CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA","CBVUJJIJTRJNOORPPCVH72DP7YDCOMDHI6WYKP3WOFVEPSCVP3TBXHIN":"CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75","CD3WN3PLW63HFZXE56OTRLMBV46WG54TFPGRL4RDQ43HQTTWVB4RPO3G":"CDTKPWPLOURQA2SGTKTUQOWRCBZEORB4BWBOMJ3D3ZTQQSGE5F6JBQLV"}'
# REBALANCE_POLL_INTERVAL_MS=60000

# ============================================================
# Keeper bot (interest accrual, price cache, TTL keepalive)
# ============================================================

# Secret key of the keeper account. Only needs XLM for transaction fees
# and TTL rent (a few XLM is plenty).
KEEPER_SECRET=""

# Vaults to run update_interest() on. boosted=true also calls
# refresh_boosted_underlying() first (DeFindex-boosted markets).
VAULTS_JSON='[{"symbol":"XLM","vaultId":"CBU4Y7CJFOUZZE3QBOXTKM54UTUYW3SDJWTNMDGJBNCR5HS5UCEKV3BE","boosted":true},{"symbol":"USDC","vaultId":"CBVUJJIJTRJNOORPPCVH72DP7YDCOMDHI6WYKP3WOFVEPSCVP3TBXHIN","boosted":true},{"symbol":"EURC","vaultId":"CD3WN3PLW63HFZXE56OTRLMBV46WG54TFPGRL4RDQ43HQTTWVB4RPO3G","boosted":true}]'

# Underlying token SACs to pre-warm in the controller's oracle cache
# (XLM, USDC, EURC).
PRICE_TOKENS_JSON='["CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA","CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75","CDTKPWPLOURQA2SGTKTUQOWRCBZEORB4BWBOMJ3D3ZTQQSGE5F6JBQLV"]'

# Contracts whose instance + wasm-code TTL the keeper keeps alive:
# controller, 3 vaults, volatile JRM, stable JRM, PERI token.
TTL_CONTRACT_IDS_JSON='["CCVUFGXKFVPAHWMMDDL6HXKUN2B2G73Z27VRM3WXZBBSQEUTNLI6YPEX","CBU4Y7CJFOUZZE3QBOXTKM54UTUYW3SDJWTNMDGJBNCR5HS5UCEKV3BE","CBVUJJIJTRJNOORPPCVH72DP7YDCOMDHI6WYKP3WOFVEPSCVP3TBXHIN","CD3WN3PLW63HFZXE56OTRLMBV46WG54TFPGRL4RDQ43HQTTWVB4RPO3G","CCPJFBH5WSNZVMCUQCBM4X5334L6ZL3W4Q33XJAK45RCDHJ2JGJ5AP6A","CCI5LBBNYOASPQ62GIRY54PDEYWWURJB75HNRAFOU4LTOU3XBC73IB5I","CDNJSOJKURHQUDBO7OHK7Z64R2CNMIAWXENHM24ALK7Y3H56EU6PUOKR"]'

# Loop intervals (defaults shown)
INTEREST_INTERVAL_MS=3600000        # 1 hour
PRICE_INTERVAL_MS=600000            # 10 minutes
TTL_INTERVAL_MS=86400000            # 24 hours
BORROWER_TTL_INTERVAL_MS=86400000   # 24 hours

# TTL policy: extend entries below ~14 days remaining up to ~30 days
# (mainnet ledgers close every ~5s; 17280 ledgers/day).
TTL_THRESHOLD_LEDGERS=241920
TTL_EXTEND_TO_LEDGERS=518400

# Borrower discovery: ledgers to scan back on first run (1 day),
# afterwards the keeper resumes from its persisted state in /data.
BORROWER_EVENT_BACKLOG=17280
STATE_FILE=/data/keeper-state.json
